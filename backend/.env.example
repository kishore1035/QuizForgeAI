# QuizForge AI Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (SQLite default, can be pointed to PostgreSQL)
DATABASE_URL=sqlite:///./data/quizforge.db

# Ollama Cloud / Nemotron 3 Nano 30B Cloud Configuration
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=nemotron-3-nano:30b-cloud
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=1
